# RevTrace — environment variable template
#
# Copy to .env and fill in real values locally:
#     cp .env.example .env
#
# .env is gitignored and MUST NEVER be committed.
# Never expose any of these values to the frontend.

# ---------------------------------------------------------------
# Razorpay — TEST MODE ONLY
# Obtain from the Razorpay Dashboard while in Test Mode.
# Test keys are prefixed rzp_test_. Do not use live keys.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# AI
# ---------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------
# Database
# Local Homebrew PostgreSQL 16 on 127.0.0.1:5432.
# The database itself is created in Phase 1, not Phase 0.
# Example: postgresql+psycopg://USER@localhost:5432/revtrace_dev
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
