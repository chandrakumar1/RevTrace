# RevTrace — environment variable template
#
# Copy to .env and fill in real values locally:
#     cp .env.example .env
#
# .env is gitignored and MUST NEVER be committed.
# Never expose any of these values to the frontend.

# ---------------------------------------------------------------
# Razorpay — TEST MODE ONLY
# Obtain from the Razorpay Dashboard while in Test Mode.
# Test keys are prefixed rzp_test_. Do not use live keys.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# AI
# ---------------------------------------------------------------
GEMINI_API_KEY=

# Read by the hypothesis agent and nothing else. A provider refuses to
# construct a client when its key is empty rather than falling back to an
# ambient credential, so a run must name its own key.
#
# OpenRouter is the only provider RevTrace calls, on a free model. Setting
# FEATHERLESS_API_KEY does not enable a paid fallback: the agent's free-only
# chain never constructs that provider.
OPENROUTER_API_KEY=
FEATHERLESS_API_KEY=

# ---------------------------------------------------------------
# Database
# Local Homebrew PostgreSQL 16 on 127.0.0.1:5432.
# The database itself is created in Phase 1, not Phase 0.
# Example: postgresql+psycopg://USER@localhost:5432/revtrace_dev
# ---------------------------------------------------------------
DATABASE_URL=

# Where the browser-facing demo runs. EMPTY MEANS THE DEMO IS OFF, and that is
# the default: /api/v1/demo/run reports itself unavailable rather than picking a
# database on its own.
#
# Deliberately separate from DATABASE_URL. The demo writes rows — a merchant, an
# order, a failed payment attempt, three events — and DATABASE_URL names the
# development database, which must never receive them.
#
# revtrace_dev and revtrace_hypothesis_test are refused by name whatever this
# holds, and the demo transaction is always rolled back; there is no HTTP
# equivalent of run_demo.py's --commit.
#
# Example: postgresql+psycopg://USER@localhost:5432/revtrace_test
DEMO_DATABASE_URL=

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# Cross-origin access (backend)
# ---------------------------------------------------------------
# The single browser origin allowed to call this API cross-origin.
# EMPTY MEANS NO CORS MIDDLEWARE IS INSTALLED AT ALL, which is correct for
# local development: the Vite dev server proxies /api, so the browser sees one
# origin and makes no cross-origin request.
#
# Set it only when the frontend is served from a different host than the API.
# Exactly one origin, never a wildcard. Scheme + host + optional port, with no
# path and no trailing slash — a browser sends the Origin header in that form,
# so anything longer matches nothing. Credentials are never enabled.
#
# Example: https://your-frontend.example.com
FRONTEND_ORIGIN=

# ---------------------------------------------------------------
# Frontend build (frontend/.env — NOT read by the backend)
# ---------------------------------------------------------------
# The absolute API origin baked into a static frontend build. Vite only exposes
# VITE_-prefixed variables to the browser bundle, and everything here ends up in
# readable JavaScript — so never put a secret in one.
#
# Leave it UNSET for local development: requests stay relative and the dev proxy
# forwards them. Set it for a deployed build, where no proxy exists.
#
# Example: VITE_API_BASE_URL=https://your-backend.example.com
